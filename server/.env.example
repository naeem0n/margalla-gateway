PORT=3847
DB_MODE=sqlite
SQLITE_PATH=./data/margalla.db
JWT_SECRET=change-this-in-production
IS_DESKTOP=false
SYNC_CLOUD_URL=
SYNC_API_KEY=

# Cloud Postgres (when DB_MODE=postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/margalla

# Pakistan SMS Gateway (smsprovider.pk or compatible)
SMS_API_KEY=YOUR_REAL_API_KEY_HERE
SMS_MASK_NAME=MARGALLA
